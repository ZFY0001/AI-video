# 一言片场 · 环境变量示例
# 复制为 .env 后按需填写。**全部留空也能跑**（管线自动走离线引擎 + 本地规则决策）。
# 每项都可缺省，缺省时的降级行为见 README「三条降级路径」。

# ── 创意层：语言大模型（任何 OpenAI 兼容端点）─────────────────────────
# 填了 LLM_API_KEY 且加 --live 才会真正调用；否则走内置离线创意引擎
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 质检前置的视觉描述模型（可选）。留空则用离线描述器
VLM_MODEL=

# ── 决策层：Jev ──────────────────────────────────────────────────
# 官方文档：https://docs.typesafe.ai  官方端点：https://api.typesafe.ai/v1
# 默认用 jevai.org（其 /api/v1/decisions/* 路径已被文档确认）；
# 注意 2026-10-14 核查时官方端点 api.typesafe.ai 全路径返回 HTTP 451。
# 未配置 JEV_API_KEY 时，决策层自动使用本地规则引擎（阈值与提示词库一致）
JEV_BASE_URL=https://www.jevai.org
JEV_API_KEY=

# ── 执行层：本地出图 ─────────────────────────────────────────────
# ComfyUI 未运行时自动降级为离线占位帧，管线照样跑通
COMFYUI_BASE_URL=http://127.0.0.1:8188

# ── 执行层：云端图生视频（按需计费，未配置则拒绝调用）────────────────
VIDEO_API_BASE_URL=
VIDEO_API_KEY=

# ── 执行层：配音 ─────────────────────────────────────────────────
# auto = 优先云端，其次 Windows SAPI，最后静音轨
TTS_ENGINE=auto
TTS_BASE_URL=
TTS_API_KEY=

# ── 预算护栏（元）─────────────────────────────────────────────────
BUDGET_CNY=20
